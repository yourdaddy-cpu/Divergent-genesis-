# Unity projects are shared between Linux CI and Windows desktops. Without this,
# a Windows checkout rewrites every .cs/.shader as CRLF, and the next Linux
# checkout shows the whole tree as modified.
*                 text=auto eol=lf

*.cs              text eol=lf
*.shader          text eol=lf
*.meta            text eol=lf
*.unity           text eol=lf
*.asset           text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.json            text eol=lf
*.py              text eol=lf
*.sh              text eol=lf
*.md              text eol=lf
*.txt             text eol=lf
.gitignore        text eol=lf
.gitattributes    text eol=lf
DgCheck.csproj    text eol=lf

# .meta files are UTF-8 text and must stay LF: a CRLF rewrite changes the file
# hash, and while the GUID survives, every diff becomes noise. Keep them text.
